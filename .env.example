# ---------------------------------------------------------------------------
# MongoDB
#
# Optional. Without it the app keeps everything in memory and starts from the
# seed data on every restart. With it, chats, messages, delivery receipts and
# push tokens survive.
#
#   local:  mongodb://127.0.0.1:27017
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# ---------------------------------------------------------------------------

NUXT_MONGODB_URI=
NUXT_MONGODB_DB=chat-app

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging
#
# Everything here is optional. With no values set, messages still send and
# receive over the WebSocket while a tab is open — only background push is off.
# ---------------------------------------------------------------------------

# Web app config: Firebase console → Project settings → Your apps → Web app
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# Project settings → Cloud Messaging → Web Push certificates → key pair
NUXT_PUBLIC_FIREBASE_VAPID_KEY=

# Service account, for sending: Project settings → Service accounts →
# Generate new private key. Keep the private key on one line with literal \n.
NUXT_FCM_PROJECT_ID=
NUXT_FCM_CLIENT_EMAIL=
NUXT_FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
